{
  "name": "@noflo/canvas",
  "description": "Canvas 2D to NoFlo",
  "version": "2.0.0-alpha.2",
  "contributors": [
    {
      "name": "Forrest Oliphant",
      "url": "http://forresto.com/"
    },
    {
      "name": "Vilson Vieira",
      "email": "vilson@void.cc",
      "url": "http://automata.cc/"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noflo/noflo-canvas.git"
  },
  "license": "MIT",
  "dependencies": {
    "@noflo/noflo": "^2.0.0-alpha.3",
    "pureimage": "^0.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@noflo/fbp-spec-runner": "^2.0.0-alpha.3",
    "@noflo/loader-node": "^2.0.0-alpha.3",
    "@types/node": "^26.6.5",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "noflo"
  ],
  "scripts": {
    "lint": "npx @biomejs/biome check --use-editorconfig=true components/ lib/ spec/ test/",
    "format": "npx @biomejs/biome check --use-editorconfig=true --write components/ lib/ spec/ test/",
    "types": "tsc -p tsconfig.json",
    "test": "npm run types && npm run lint && npm run test:spec && npm run test:node",
    "test:spec": "node \"$(node -p \"require.resolve('@noflo/fbp-spec-runner/src/cli.js')\")\" spec/",
    "test:node": "node --test test/*.test.js",
    "test:bun": "bun test test/*.test.js",
    "test:deno": "deno test --allow-all --no-check test/*.test.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./engine": {
      "browser": "./lib/engines/browser.js",
      "node": "./lib/engines/node.js"
    }
  },
  "files": [
    "components/",
    "graphs/",
    "lib/",
    "spec/",
    "test/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
